{
  "$schema": "https://raw.githubusercontent.com/cloudflare/wrangler3/main/schemas/config.schema.json",
  "name": "redirecty",
  "main": "src/index.ts",
  "compatibility_date": "2024-04-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "DATABASE_URL": "postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"
  }
} 